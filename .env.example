# Copy to .env (never commit .env). Read by docker compose, the Makefile and the service.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep comments on their own lines: `make` would include an inline comment in the value.

# --- environment ------------------------------------------------------------------------
# production | development
APP_ENV=production
# json | text
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- API access ---------------------------------------------------------------------------
# Jury / integration keys are issued at runtime and stored hashed in Redis:
#     docker compose run --rm init admin create-api-key --name jury
# API_KEYS (comma list): optional bootstrap keys accepted in addition; leave empty in production.
API_KEYS=
# Public origin(s) of the web UI, used for CSRF checks of cookie-authenticated requests
PUBLIC_ORIGIN=https://forte.example.kz
# 0 only for local http development
COOKIE_SECURE=1
SESSION_TTL_H=12
# Bearer token for GET /metrics (Prometheus); empty = /metrics disabled
METRICS_TOKEN=
# 1 exposes /api/docs (Swagger): development only
ENABLE_DOCS=0

# --- state: Redis + object storage --------------------------------------------------------
# docker-compose.yml builds REDIS_URL from REDIS_PASSWORD; with an existing Redis set REDIS_URL instead:
#REDIS_URL=redis://:password@redis-host:6379/0
REDIS_PASSWORD=change-me-random
# STORAGE_BACKEND: fs (default in docker compose: the `data` volume shared by api and worker) | s3 (any S3 API,
# needed when api and workers run on different hosts). With an external S3 / Ceph / MinIO:
#STORAGE_BACKEND=s3
#S3_BUCKET=forte-vision
#S3_ENDPOINT=https://s3.example.kz
#S3_REGION=us-east-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_SSE=AES256
# results and logs are kept this long; videos are deleted right after analysis
JOB_TTL_DAYS=30

# --- jobs and workers -----------------------------------------------------------------------
# parallel analyses per worker container (size it with scripts/loadtest.py)
WORKER_COUNT=4
# hard limit per video (the jury limit is 5 minutes)
JOB_TIMEOUT_S=290
# one retry, only for GPU-server outages / lost workers
JOB_MAX_ATTEMPTS=2
# how long a job waits for an unreachable GPU server before failing
INFRA_WAIT_S=60
MAX_UPLOAD_MB=100
MAX_VIDEO_S=900
# per web-UI user; API keys are not capped
UI_MAX_ACTIVE_JOBS=3

# --- GPU servers (team-controlled; see GPU_ACCESS.md) ------------------------------------------
# openai = our vLLM server over HTTP; mlx / vllm = in-process (development)
VLM_BACKEND=openai
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
VLM_API_BASE=https://vlm-host.example/v1
VLM_API_KEY=change-me
# parallel requests per job to the vLLM server (it batches them)
VLM_CONCURRENCY=16
DET_API_BASE=https://cv-host.example
DET_API_KEY=change-me
DET_CONCURRENCY=8

# --- docker compose -------------------------------------------------------------------------
# only the frontend (nginx) is published; PUBLIC_ORIGIN must be the URL users open
PUBLIC_PORT=8080
#PUBLIC_BIND=127.0.0.1
# images: REGISTRY/forte-backend:IMAGE_TAG, REGISTRY/forte-frontend:IMAGE_TAG (CI pushes ghcr.io/atropass/...:sha-<commit>)
#REGISTRY=ghcr.io/atropass
#IMAGE_TAG=latest
# for `docker compose --profile tls up -d` (Caddy, automatic HTTPS)
#DOMAIN=forte.example.kz
