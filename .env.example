# Copy to .env (never commit .env). Makefile and the service read it.

# --- key the JURY/UI uses for OUR API (X-API-Key). Long random value for production:
#     python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=dev-key

# --- where the VLM runs ---------------------------------------------------------------
# openai = our own vLLM server over HTTP (team GPU pod), mlx = Apple silicon in-process, vllm = in-process on NVIDIA
VLM_BACKEND=openai
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
VLM_API_BASE=https://<pod-id>-8000.proxy.runpod.net/v1
VLM_API_KEY=<gateway bearer token>
# parallel requests to the vLLM server (it batches them); lower it if the gateway rate-limits (HTTP 429)
VLM_CONCURRENCY=16

# --- person detector: our RT-DETRv2 CV service on a GPU pod (otherwise runs locally)
DET_API_BASE=https://<cv-pod-id>-8000.proxy.runpod.net
# DET_API_KEY defaults to VLM_API_KEY; DET_CONCURRENCY=8

# --- Docker deployment with an in-container vLLM (GPU on the same machine) -----------------
PUBLIC_PORT=80
#VLM_AUX_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#VLLM_GPU_UTIL_MAIN=0.40
#VLLM_GPU_UTIL_AUX=0.35
