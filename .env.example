# copy to .env and set a long random key:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=change-me
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
PUBLIC_PORT=80

# Optional: second model used ONLY on hand-over frames (client ID / collector documents, V05/V13).
# Both models share the GPU: main 0.40 + aux 0.35 of memory. 48 GB GPU (L40S) recommended for this.
# Download it first:  AUX_MODEL=Qwen/Qwen2.5-VL-7B-Instruct scripts/download_weights.sh
#VLM_AUX_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#VLLM_GPU_UTIL_MAIN=0.40
#VLLM_GPU_UTIL_AUX=0.35
