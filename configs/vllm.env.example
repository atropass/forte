# Production vLLM Configuration
# Model & Endpoint
VLLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
# VLLM_API_KEY lives in /workspace/secrets.env on the pod (never in the repo)

# Resource & Engine Hyperparameters
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=32

# Multi-tenant Latency Optimizations
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_ENABLE_PREFIX_CACHING=true

# Persistent Cache Directories
HF_HOME=/workspace/hf_home
VLLM_CACHE_ROOT=/workspace/.cache/vllm
TORCH_EXTENSIONS_DIR=/workspace/.cache/torch_extensions
LOG_DIR=/workspace/logs
