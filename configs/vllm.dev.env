# Development vLLM Configuration (Cheaper, Faster, Lightweight)
# Model: 2.2B Vision-Language model (Apache-2.0, ~4 GB VRAM)
VLLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
VLLM_API_KEY=fv-dev-secret-forte-2026

# Resource Tuning for Dev (Minimal VRAM, Fast Boot)
VLLM_GPU_MEMORY_UTILIZATION=0.60
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=16

# Multi-tenant Latency Optimizations
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_ENABLE_PREFIX_CACHING=true

# Persistent Cache Directories
HF_HOME=/workspace/hf_home
VLLM_CACHE_ROOT=/workspace/.cache/vllm
TORCH_EXTENSIONS_DIR=/workspace/.cache/torch_extensions
LOG_DIR=/workspace/logs
